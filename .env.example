# =====================================================================
# CAREVERSE CONFIGURATION (.env.example)
# Note: CAREVERSE is zero-config ready out of the box!
# When optional API keys are omitted, the application runs seamlessly
# using its built-in persistent storage adapter and visual notification simulator.
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=careverse-super-secret-jwt-key-for-dev-2026!
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL & Auth (Optional in development)
# If provided, connects to real Supabase PostgreSQL instance
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Delivery (Optional)
# If provided, dispatches live emails to patients and caregivers
# If omitted, notifications are logged into the in-app Visual Notification Simulator
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=CAREVERSE <notifications@careverse.health>

# AI Assistant Integration (Optional)
# If provided, connects to external LLM provider
# If omitted, uses intelligent contextual rule-based healthcare synthesizer
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
