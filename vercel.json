{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api(?:/.*)?$", "dest": "/api/index" },
    { "src": "^/(?!api(?:/|$)|assets/|screenshots/)[^.]*$", "dest": "/index.html" }
  ]
}
